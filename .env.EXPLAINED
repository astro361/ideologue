# ============================================================================
# IdeaLogue Environment Variables - EXPLAINED
# ============================================================================
# This file explains what each variable in your .env file does and where to get it
# Copy the values to your actual .env file


# ============================================================================
# 1. DATABASE_URL - PostgreSQL Connection String
# ============================================================================
# WHAT IT IS:
#   The connection string to your PostgreSQL database
#
# FORMAT:
#   postgresql://[username]:[password]@[host]:[port]/[database_name]
#
# WHERE TO GET IT:
#   Local Development:
#     DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
#
#   Production (Vercel Postgres):
#     Automatically set when you add Vercel Postgres to your project
#
#   Production (Neon.tech):
#     1. Go to https://neon.tech
#     2. Create a project
#     3. Copy the connection string from dashboard
#
#   Production (Supabase):
#     1. Go to https://supabase.com
#     2. Create a project
#     3. Go to Settings → Database → Connection String
#
# EXAMPLE:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db


# ============================================================================
# 2. NEXTAUTH_URL - Your Application's Base URL
# ============================================================================
# WHAT IT IS:
#   The canonical URL where your application is hosted
#
# WHY YOU NEED IT:
#   NextAuth uses this for OAuth redirects and generating callback URLs
#
# VALUES:
#   Local Development:
#     NEXTAUTH_URL=http://localhost:3000
#
#   Production:
#     NEXTAUTH_URL=https://yourdomain.com
#
# IMPORTANT:
#   - Must match exactly where your app is deployed
#   - Include http:// or https://
#   - No trailing slash
#
# EXAMPLE:
NEXTAUTH_URL=http://localhost:3000


# ============================================================================
# 3. NEXTAUTH_SECRET - Session Encryption Key
# ============================================================================
# WHAT IT IS:
#   A random string used to encrypt session tokens and cookies
#
# WHY YOU NEED IT:
#   Keeps user sessions secure and prevents token tampering
#
# HOW TO GENERATE:
#   Method 1 - OpenSSL (recommended):
#     openssl rand -base64 32
#
#   Method 2 - Node.js:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
#   Method 3 - Online:
#     Visit: https://generate-secret.vercel.app/32
#
# REQUIREMENTS:
#   - Must be at least 32 characters
#   - Should be completely random
#   - Different for development vs production
#   - Never commit to version control
#
# EXAMPLE OUTPUT:
#   jK8mN2pQ4rS6tU8vW0xY2zA4bC6dE8fG0hI2jK4mN6pQ8rS0tU2vW4xY6zA8bC0d
#
# EXAMPLE:
NEXTAUTH_SECRET=super-secret-development-key-change-in-production-please


# ============================================================================
# 4. GOOGLE_CLIENT_ID - Google OAuth Client ID
# ============================================================================
# WHAT IT IS:
#   Public identifier for your Google OAuth application
#
# WHY YOU NEED IT:
#   Allows users to sign in with their Google accounts
#
# HOW TO GET IT:
#   1. Go to: https://console.cloud.google.com/
#   2. Create a new project (or select existing)
#   3. Go to "APIs & Services" → "Credentials"
#   4. Click "Create Credentials" → "OAuth client ID"
#   5. Choose "Web application"
#   6. Add Authorized redirect URIs:
#      - Development: http://localhost:3000/api/auth/callback/google
#      - Production: https://yourdomain.com/api/auth/callback/google
#   7. Copy the Client ID
#
# FORMAT:
#   Ends with: .apps.googleusercontent.com
#
# EXAMPLE:
GOOGLE_CLIENT_ID="809221721195-b3bmk7q8tig3ckp6nnek3lso2cef00ve.apps.googleusercontent.com"


# ============================================================================
# 5. GOOGLE_CLIENT_SECRET - Google OAuth Client Secret
# ============================================================================
# WHAT IT IS:
#   Secret key for your Google OAuth application
#
# WHY YOU NEED IT:
#   Used with Client ID to authenticate your application with Google
#
# HOW TO GET IT:
#   - Generated at the same time as Client ID (see step 4 above)
#   - You can view it in Google Cloud Console → Credentials
#
# FORMAT:
#   Starts with: GOCSPX-
#
# SECURITY:
#   - Keep this secret!
#   - Never commit to version control
#   - Never share publicly
#
# EXAMPLE:
GOOGLE_CLIENT_SECRET="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"


# ============================================================================
# QUICK CHECKLIST
# ============================================================================
# ✅ Copy .env.example to .env
# ✅ Set DATABASE_URL (use local PostgreSQL for dev)
# ✅ Set NEXTAUTH_URL (http://localhost:3000 for dev)
# ✅ Generate and set NEXTAUTH_SECRET (openssl rand -base64 32)
# ✅ Get Google OAuth credentials from Google Cloud Console
# ✅ Set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET
# ✅ Verify .env is in .gitignore
# ✅ Never commit .env to git
# ✅ Push database schema: npx drizzle-kit push
# ✅ Start dev server: npm run dev


# ============================================================================
# PRODUCTION DEPLOYMENT CHANGES
# ============================================================================
# When deploying to production, you MUST change:
#
# 1. NEXTAUTH_URL → Your production domain
#    NEXTAUTH_URL=https://yourdomain.com
#
# 2. NEXTAUTH_SECRET → Generate a new random secret
#    openssl rand -base64 32
#
# 3. DATABASE_URL → Your production database
#    (Vercel Postgres, Neon, Supabase, etc.)
#
# 4. Google OAuth → Add production redirect URI
#    https://yourdomain.com/api/auth/callback/google
#    (Add this in Google Cloud Console)


# ============================================================================
# TESTING YOUR SETUP
# ============================================================================
# 1. Check if all variables are set:
#    cat .env
#
# 2. Test database connection:
#    npx drizzle-kit studio
#
# 3. Start the app:
#    npm run dev
#
# 4. Test Google OAuth:
#    - Go to http://localhost:3000
#    - Click "Sign In"
#    - Select your Google account
#    - You should be redirected back, logged in ✅


